# Test User Creation Script Environment Variables

# Required: Email for the test user
TEST_USER_EMAIL=reviewer@example.com

# Required: Password for the test user (use a secure password)
TEST_USER_PASSWORD=SecurePassword123!

# Optional: Display name for the test user
TEST_USER_DISPLAY_NAME=Test Reviewer

# Optional: Role for the test user (default: member)
# Use 'member' for regular users. Admin role must be granted manually in Firestore Console
TEST_USER_ROLE=member

# Optional: Path to Firebase service account JSON file
# Default: ../mobile/firebase-secrets/beteldej/service-account.json
SERVICE_ACCOUNT_PATH=../mobile/firebase-secrets/beteldej/service-account.json
