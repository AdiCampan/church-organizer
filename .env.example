# Test User Creation Script Environment Variables

# Required: Email for the test user
TEST_USER_EMAIL=reviewer@example.com

# Required: Password for the test user (use a secure password)
# IMPORTANT: Never commit real passwords. Set this in your local .env file
TEST_USER_PASSWORD=

# Required for reviewer account scripts (fix-reviewer, reset-reviewer)
# IMPORTANT: Set this in your local .env file, never commit the real password
REVIEWER_PASSWORD=

# Optional: Display name for the test user
TEST_USER_DISPLAY_NAME="Test Reviewer"

# Optional: Role for the test user (default: member)
# Use 'admin' for store reviewers to give full access
# Use 'member' for regular users
TEST_USER_ROLE=member

# Optional: Path to Firebase service account JSON file
# Default: ../mobile/firebase-secrets/beteldej/service-account.json
# To get this file:
# 1. Go to: https://console.firebase.google.com
# 2. Select: beteldej-teams project
# 3. Go to: Project Settings → Service accounts
# 4. Click: "Generate new private key"
# 5. Save to: ../mobile/firebase-secrets/beteldej/service-account.json
SERVICE_ACCOUNT_PATH=../mobile/firebase-secrets/beteldej/service-account.json
