rules_version = '2';

// Estas reglas replican EXACTAMENTE lo que esta desplegado hoy en los dos
// proyectos de Firebase (church-teams y church-teams-8ea48). Revisadas en la
// consola el 25/11/2026. Si se despliegan desde aqui, no cambia nada.
//
// Cubren todas las colecciones, incluida song_tags (etiquetas de canciones y
// sus subcategorias, que usan el campo parentId).
//
// La version anterior de este archivo era un borrador mas estricto que nunca
// se desplego. No incluia song_tags, announcements, roles, locations,
// service_types ni otras colecciones que la app usa, asi que desplegarla
// habria roto el panel y la app movil.
//
// TODO: restringir la escritura por rol (admin) coleccion a coleccion, despues
// de comprobar que accesos hacen el dashboard, la app movil y las functions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if request.auth != null; // Base rule for other collections
    }
  }
}
