{
  "name": "church-teams",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "test": "node src/authHelpers.test.js && node src/accountDeletion.test.js && node src/agendaItemInteraction.test.js",
    "build:android": "npx eas-cli@latest build --platform android --profile churchteams",
    "build:ios": "npx eas-cli@latest build --platform ios --profile churchteams",
    "build:all": "npx eas-cli@latest build --platform all --profile churchteams",
    "submit:android": "npx eas-cli@latest submit --platform android --latest --profile churchteams",
    "submit:ios": "npx eas-cli@latest submit --platform ios --latest --profile churchteams",
    "submit:all": "npm run submit:android && npm run submit:ios",
    "release:all": "npx eas-cli@latest build --platform all --profile churchteams --auto-submit-with-profile churchteams"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/stack": "^7.6.13",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.7.0",
    "lucide-react-native": "^0.562.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "private": true
}
